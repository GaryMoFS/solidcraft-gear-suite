{
  "id": "solidcraft-gear-suite",
  "name": "GM Gear Suite",
  "version": "0.3.0",
  "description": "Complete Shwivel-style parametric gear & drive suite: External/Internal Cylindrical (Straight, Helical, Herringbone), Parallel Pair, Planetary Set, Rack & Pinion, Cycloidal Drive, Bevel Pair, Worm Drive, and Knurl Maker.",
  "capabilities": ["commands@0.2"],
  "runtime": {
    "module": "solidcraft-gear-suite.wasm",
    "commands": [
      "document.inspect",
      "selection.get",
      "inspect.measure",
      "model.faces",
      "model.edges",
      "sketch.inspect",
      "parameters.list",
      "parameters.add",
      "parameters.change",
      "sketch.create",
      "sketch.circle.center",
      "sketch.equation_curve",
      "sketch.line",
      "sketch.arc.three_point",
      "sketch.pattern.circular",
      "sketch.finish",
      "solid.cylinder",
      "solid.extrude",
      "solid.sweep",
      "solid.loft",
      "solid.mirror",
      "solid.combine"
    ],
    "limits": {
      "fuel": 250000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    },
    "entries": [
      {
        "name": "gm-cylindrical-gear",
        "effect": "edit",
        "slots": [
          { "kind": "menu", "name": "GM Cylindrical Gear..." },
          { "kind": "ribbon", "name": "GM Gear" }
        ],
        "input_schema": {
          "type": "object",
          "required": ["gear_side", "tooth_type", "prefix", "module", "teeth", "face_width", "pressure_angle"],
          "x-solidcraft-order": [
            "placement", "axis_name", "base_plane", "flip_direction", "axial_offset",
            "gear_side", "tooth_type", "helix_angle", "hand", "module_system",
            "prefix", "module", "teeth", "pressure_angle", "face_width",
            "bore_diameter", "rim_thickness", "profile_shift", "backlash", "body_name"
          ],
          "properties": {
            "placement": {
              "type": "array",
              "title": "Placement Reference (optional)",
              "description": "Pick an axis, plane, face, circular edge, or sketch point.",
              "maxItems": 1,
              "items": { "type": "object" },
              "x-solidcraft-selection": { "version": 1, "accept": ["axis", "plane", "face", "edge", "sketch_point", "sketch_curve"] }
            },
            "axis_name": { "type": "string", "title": "Axis Name (optional)", "default": "" },
            "base_plane": {
              "type": "string",
              "title": "Base Plane (if no pick)",
              "oneOf": [
                { "const": "XY", "title": "XY Plane (Z Axis)" },
                { "const": "XZ", "title": "XZ Plane (Y Axis)" },
                { "const": "YZ", "title": "YZ Plane (X Axis)" }
              ],
              "default": "XY"
            },
            "flip_direction": { "type": "boolean", "title": "Flip Direction", "default": false },
            "axial_offset": { "type": "number", "title": "Axial Offset", "unit": "mm", "minimum": -1000.0, "maximum": 1000.0, "default": 0.0 },
            "gear_side": {
              "type": "string",
              "title": "Gear Side",
              "oneOf": [
                { "const": "external", "title": "External Gear" },
                { "const": "internal", "title": "Internal Ring Gear" }
              ],
              "default": "external"
            },
            "tooth_type": {
              "type": "string",
              "title": "Tooth Type",
              "oneOf": [
                { "const": "straight", "title": "Straight" },
                { "const": "helical", "title": "Helical" },
                { "const": "herringbone", "title": "Herringbone (Double Helical)" }
              ],
              "default": "straight"
            },
            "helix_angle": {
              "type": "number", "title": "Helix Angle", "unit": "deg", "minimum": 1.0, "maximum": 45.0, "default": 15.0,
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "hand": {
              "type": "string", "title": "Helix Hand",
              "oneOf": [
                { "const": "right", "title": "Right-Hand (RH)" },
                { "const": "left", "title": "Left-Hand (LH)" }
              ],
              "default": "right",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "module_system": {
              "type": "string", "title": "Module System",
              "oneOf": [
                { "const": "normal", "title": "Normal (ISO Standard)" },
                { "const": "transverse", "title": "Transverse (Axial)" }
              ],
              "default": "normal",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "prefix": { "type": "string", "title": "Parameter Prefix", "default": "g1" },
            "module": { "type": "number", "title": "Module", "unit": "mm", "minimum": 0.25, "maximum": 50.0, "default": 2.0 },
            "teeth": { "type": "integer", "title": "Teeth", "minimum": 8, "maximum": 120, "default": 20 },
            "pressure_angle": { "type": "number", "title": "Pressure Angle", "unit": "deg", "minimum": 14.5, "maximum": 25.0, "default": 20.0 },
            "face_width": { "type": "number", "title": "Face Width", "unit": "mm", "minimum": 0.5, "maximum": 500.0, "default": 10.0 },
            "bore_diameter": {
              "type": "number", "title": "Bore Diameter", "unit": "mm", "minimum": 0.0, "maximum": 500.0, "default": 8.0,
              "x-solidcraft-visible-when": { "field": "gear_side", "eq": "external" }
            },
            "rim_thickness": {
              "type": "number", "title": "Ring Wall Thickness", "unit": "mm", "minimum": 1.0, "maximum": 200.0, "default": 6.0,
              "x-solidcraft-visible-when": { "field": "gear_side", "eq": "internal" }
            },
            "profile_shift": { "type": "number", "title": "Profile Shift", "minimum": -0.5, "maximum": 1.0, "default": 0.0 },
            "backlash": { "type": "number", "title": "Backlash", "unit": "mm", "minimum": 0.0, "maximum": 5.0, "default": 0.05 },
            "body_name": { "type": "string", "title": "Body Name", "default": "GM_Gear" }
          }
        }
      },
      {
