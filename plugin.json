            "module": { "type": "number", "title": "Module", "unit": "mm", "minimum": 0.25, "maximum": 50.0, "default": 2.0 },
            "teeth_1": { "type": "integer", "title": "Pinion Teeth (Z1)", "minimum": 8, "maximum": 100, "default": 16 },
            "teeth_2": { "type": "integer", "title": "Gear Teeth (Z2)", "minimum": 8, "maximum": 100, "default": 32 },
            "pressure_angle": { "type": "number", "title": "Pressure Angle", "unit": "deg", "minimum": 14.5, "maximum": 25.0, "default": 20.0 },
            "face_width": { "type": "number", "title": "Face Width", "unit": "mm", "minimum": 0.5, "maximum": 500.0, "default": 10.0 },
            "bore_1": { "type": "number", "title": "Pinion Bore (D1)", "unit": "mm", "minimum": 0.0, "maximum": 500.0, "default": 6.0 },
            "bore_2": { "type": "number", "title": "Gear Bore (D2)", "unit": "mm", "minimum": 0.0, "maximum": 500.0, "default": 10.0 },
            "backlash": { "type": "number", "title": "Backlash (Total)", "unit": "mm", "minimum": 0.0, "maximum": 5.0, "default": 0.05 },
            "backlash_mode": {
              "type": "string", "title": "Backlash Method",
              "oneOf": [
                { "const": "tooth_thinning", "title": "Tooth Thinning (Fixed Center Distance)" },
