{
  "id": "solidcraft-gear-suite",
  "name": "GM Gear Suite",
  "version": "0.2.0",
  "description": "Parametric equation-driven gear suite: straight, helical, and herringbone cylindrical gears and meshing parallel gear pairs that auto-rebuild from SolidCraft Design Parameters.",
  "capabilities": ["commands@0.2"],
  "runtime": {
    "module": "solidcraft-gear-suite.wasm",
    "commands": [
      "document.inspect",
      "selection.get",
      "inspect.measure",
      "model.faces",
      "model.edges",
      "sketch.inspect",
      "parameters.list",
      "parameters.add",
      "parameters.change",
      "sketch.create",
      "sketch.equation_curve",
      "sketch.line",
      "sketch.arc.three_point",
      "sketch.finish",
      "solid.cylinder",
      "solid.extrude",
      "solid.sweep",
      "solid.mirror",
      "solid.pattern.circular"
    ],
    "limits": {
      "fuel": 150000000,
      "memory_mib": 64,
      "deadline_ms": 30000
    },
    "entries": [
      {
        "name": "gm-cylindrical-gear",
        "effect": "edit",
        "slots": [
          { "kind": "menu", "name": "GM Cylindrical Gear..." },
          { "kind": "ribbon", "name": "GM Gear" }
        ],
        "input_schema": {
          "type": "object",
          "required": ["tooth_type", "prefix", "module", "teeth", "face_width", "pressure_angle"],
          "x-solidcraft-order": [
            "placement",
            "axis_name",
            "base_plane",
            "flip_direction",
            "axial_offset",
            "tooth_type",
            "helix_angle",
            "hand",
            "module_system",
            "prefix",
            "module",
            "teeth",
            "pressure_angle",
            "face_width",
            "bore_diameter",
            "profile_shift",
            "backlash",
            "body_name"
          ],
          "properties": {
            "placement": {
              "type": "array",
              "title": "Placement Reference (optional)",
              "description": "Pick an axis, plane, planar face, cylindrical face (shaft/bore), circular edge, or sketch point to place the gear. Leave empty to place at Origin.",
              "maxItems": 1,
              "items": { "type": "object" },
              "x-solidcraft-selection": { "version": 1, "accept": ["axis", "plane", "face", "edge", "sketch_point", "sketch_curve"] }
            },
            "axis_name": {
              "type": "string",
              "title": "Axis Name (optional)",
              "description": "Origin axis (X, Y, Z) or Construction Axis name (e.g. Axis1) to mount coaxially on. Used when no Placement Reference is picked.",
              "default": ""
            },
            "base_plane": {
              "type": "string",
              "title": "Base Plane (if no pick)",
              "description": "Origin plane used when no Placement Reference is selected.",
              "oneOf": [
                { "const": "XY", "title": "XY Plane (Z Axis)" },
                { "const": "XZ", "title": "XZ Plane (Y Axis)" },
                { "const": "YZ", "title": "YZ Plane (X Axis)" }
              ],
              "default": "XY"
            },
            "flip_direction": {
              "type": "boolean",
              "title": "Flip Direction",
              "description": "Reverse the gear extrude direction along the shaft axis.",
              "default": false
            },
            "axial_offset": {
              "type": "number",
              "title": "Axial Offset",
              "description": "Standoff distance along the shaft axis from the placement reference.",
              "unit": "mm",
              "minimum": -1000.0,
              "maximum": 1000.0,
              "default": 0.0
            },
            "tooth_type": {
              "type": "string",
              "title": "Tooth Type",
              "description": "Straight (spur), single Helical, or Herringbone (double helical).",
              "oneOf": [
                { "const": "straight", "title": "Straight" },
                { "const": "helical", "title": "Helical" },
                { "const": "herringbone", "title": "Herringbone (Double Helical)" }
              ],
              "default": "straight"
            },
            "helix_angle": {
              "type": "number",
              "title": "Helix Angle",
              "description": "Helix angle beta on the pitch cylinder.",
              "unit": "deg",
              "minimum": 1.0,
              "maximum": 45.0,
              "default": 15.0,
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "hand": {
              "type": "string",
              "title": "Helix Hand",
              "description": "Helix twist direction (for herringbone, applies to the lower half).",
              "oneOf": [
                { "const": "right", "title": "Right-Hand (RH)" },
                { "const": "left", "title": "Left-Hand (LH)" }
              ],
              "default": "right",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "module_system": {
              "type": "string",
              "title": "Module System",
              "description": "Normal (ISO 21771 standard: mt = mn / cos(beta)) or Transverse (mt = m).",
              "oneOf": [
                { "const": "normal", "title": "Normal (ISO Standard)" },
                { "const": "transverse", "title": "Transverse (Axial)" }
              ],
              "default": "normal",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "prefix": {
              "type": "string",
              "title": "Parameter Prefix",
              "description": "Prefix for created Design Parameters (e.g. g1 -> g1_m, g1_z, g1_fw).",
              "default": "g1"
            },
            "module": {
              "type": "number",
              "title": "Module",
              "description": "Gear module m (normal mn for helical ISO standard, transverse mt otherwise).",
              "unit": "mm",
              "minimum": 0.25,
              "maximum": 50.0,
              "default": 2.0
            },
            "teeth": {
              "type": "integer",
              "title": "Teeth",
              "description": "Number of teeth z.",
              "minimum": 8,
              "maximum": 80,
              "default": 20
            },
            "pressure_angle": {
              "type": "number",
              "title": "Pressure Angle",
              "description": "Tooth flank pressure angle (normal alpha_n for ISO helical).",
              "unit": "deg",
              "minimum": 14.5,
              "maximum": 25.0,
              "default": 20.0
            },
            "face_width": {
              "type": "number",
              "title": "Face Width",
              "description": "Total gear thickness along shaft axis.",
              "unit": "mm",
              "minimum": 0.5,
              "maximum": 500.0,
              "default": 10.0
            },
            "bore_diameter": {
              "type": "number",
              "title": "Bore Diameter",
              "description": "Center bore diameter (0 for solid hub).",
              "unit": "mm",
              "minimum": 0.0,
              "maximum": 500.0,
              "default": 8.0
            },
            "profile_shift": {
              "type": "number",
              "title": "Profile Shift",
              "description": "Addendum modification coefficient x.",
              "minimum": -0.5,
              "maximum": 1.0,
              "default": 0.0
            },
            "backlash": {
              "type": "number",
              "title": "Backlash",
              "description": "Circumferential tooth thinning allowance on the pitch circle.",
              "unit": "mm",
              "minimum": 0.0,
              "maximum": 5.0,
              "default": 0.05
            },
            "body_name": {
              "type": "string",
              "title": "Body Name",
              "description": "Optional name for the generated gear body.",
              "default": "GM_Gear"
            }
          }
        }
      },
      {
        "name": "gm-parallel-pair",
        "effect": "edit",
        "slots": [
          { "kind": "menu", "name": "GM Parallel Gear Pair..." },
          { "kind": "ribbon", "name": "GM Parallel Pair" }
        ],
        "input_schema": {
          "type": "object",
          "required": ["tooth_type", "prefix", "module", "teeth_1", "teeth_2", "face_width", "pressure_angle"],
          "x-solidcraft-order": [
            "placement",
            "axis_name",
            "base_plane",
            "layout_angle",
            "flip_direction",
            "axial_offset",
            "tooth_type",
            "helix_angle",
            "hand",
            "module_system",
            "prefix",
            "module",
            "teeth_1",
            "teeth_2",
            "pressure_angle",
            "face_width",
            "bore_1",
            "bore_2",
            "backlash",
            "backlash_mode"
          ],
          "properties": {
            "placement": {
              "type": "array",
              "title": "Pinion Placement Reference (optional)",
              "description": "Pick an axis, plane, planar face, cylindrical face (shaft/bore), circular edge, or sketch point to place the pinion. Leave empty to place at Origin.",
              "maxItems": 1,
              "items": { "type": "object" },
              "x-solidcraft-selection": { "version": 1, "accept": ["axis", "plane", "face", "edge", "sketch_point", "sketch_curve"] }
            },
            "axis_name": {
              "type": "string",
              "title": "Axis Name (optional)",
              "description": "Origin axis (X, Y, Z) or Construction Axis name (e.g. Axis1) to mount coaxially on. Used when no Placement Reference is picked.",
              "default": ""
            },
            "base_plane": {
              "type": "string",
              "title": "Base Plane (if no pick)",
              "description": "Origin plane used when no Placement Reference is selected.",
              "oneOf": [
                { "const": "XY", "title": "XY Plane (Z Axis)" },
                { "const": "XZ", "title": "XZ Plane (Y Axis)" },
                { "const": "YZ", "title": "YZ Plane (X Axis)" }
              ],
              "default": "XY"
            },
            "layout_angle": {
              "type": "number",
              "title": "Pair Layout Angle",
              "description": "Angle in the gear plane from Pinion to Gear 2 (0 deg = +X, 90 deg = +Y).",
              "unit": "deg",
              "minimum": -360.0,
              "maximum": 360.0,
              "default": 0.0
            },
            "flip_direction": {
              "type": "boolean",
              "title": "Flip Direction",
              "description": "Reverse the gear extrude direction along the shaft axis.",
              "default": false
            },
            "axial_offset": {
              "type": "number",
              "title": "Axial Offset",
              "description": "Standoff distance along the shaft axis from the placement reference.",
              "unit": "mm",
              "minimum": -1000.0,
              "maximum": 1000.0,
              "default": 0.0
            },
            "tooth_type": {
              "type": "string",
              "title": "Tooth Type",
              "description": "Straight, single Helical (opposite hands on Gear 1 & 2), or Herringbone (double helical).",
              "oneOf": [
                { "const": "straight", "title": "Straight" },
                { "const": "helical", "title": "Helical" },
                { "const": "herringbone", "title": "Herringbone (Double Helical)" }
              ],
              "default": "straight"
            },
            "helix_angle": {
              "type": "number",
              "title": "Helix Angle",
              "description": "Shared helix angle beta on the pitch cylinders.",
              "unit": "deg",
              "minimum": 1.0,
              "maximum": 45.0,
              "default": 15.0,
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "hand": {
              "type": "string",
              "title": "Pinion Helix Hand",
              "description": "Helix hand for Pinion (Gear 1); Gear 2 automatically uses the opposite hand to mesh.",
              "oneOf": [
                { "const": "right", "title": "Right-Hand (Pinion RH / Gear LH)" },
                { "const": "left", "title": "Left-Hand (Pinion LH / Gear RH)" }
              ],
              "default": "right",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "module_system": {
              "type": "string",
              "title": "Module System",
              "description": "Normal (ISO 21771 standard: mt = mn / cos(beta)) or Transverse (mt = m).",
              "oneOf": [
                { "const": "normal", "title": "Normal (ISO Standard)" },
                { "const": "transverse", "title": "Transverse (Axial)" }
              ],
              "default": "normal",
              "x-solidcraft-visible-when": { "field": "tooth_type", "in": ["helical", "herringbone"] }
            },
            "prefix": {
              "type": "string",
              "title": "Parameter Prefix",
              "description": "Prefix for shared pair parameters (e.g. p1 -> p1_m, p1_z1, p1_z2, p1_cd, p1_ratio).",
              "default": "p1"
            },
            "module": {
              "type": "number",
              "title": "Module",
              "description": "Shared module m for both gears.",
              "unit": "mm",
              "minimum": 0.25,
              "maximum": 50.0,
              "default": 2.0
            },
            "teeth_1": {
              "type": "integer",
              "title": "Pinion Teeth (Z1)",
              "description": "Number of teeth on Gear 1 (at placement reference).",
              "minimum": 8,
              "maximum": 80,
              "default": 16
            },
            "teeth_2": {
              "type": "integer",
              "title": "Gear Teeth (Z2)",
              "description": "Number of teeth on Gear 2 (at center distance).",
              "minimum": 8,
              "maximum": 80,
              "default": 32
            },
            "pressure_angle": {
              "type": "number",
              "title": "Pressure Angle",
              "description": "Shared pressure angle.",
              "unit": "deg",
              "minimum": 14.5,
              "maximum": 25.0,
              "default": 20.0
            },
            "face_width": {
              "type": "number",
              "title": "Face Width",
              "description": "Shared total gear thickness along shaft axis.",
              "unit": "mm",
              "minimum": 0.5,
              "maximum": 500.0,
              "default": 10.0
            },
            "bore_1": {
              "type": "number",
              "title": "Pinion Bore (D1)",
              "description": "Center bore diameter for Gear 1 (0 for none).",
              "unit": "mm",
              "minimum": 0.0,
              "maximum": 500.0,
              "default": 6.0
            },
            "bore_2": {
              "type": "number",
              "title": "Gear Bore (D2)",
              "description": "Center bore diameter for Gear 2 (0 for none).",
              "unit": "mm",
              "minimum": 0.0,
              "maximum": 500.0,
              "default": 10.0
            },
            "backlash": {
              "type": "number",
              "title": "Backlash (Total)",
              "description": "Total circumferential meshing backlash jt on the pitch circle (ISO 21771).",
              "unit": "mm",
              "minimum": 0.0,
              "maximum": 5.0,
              "default": 0.05
            },
            "backlash_mode": {
              "type": "string",
              "title": "Backlash Method",
              "description": "Tooth Thinning keeps nominal center distance and thins each gear by jt/2. Center Distance Increase keeps nominal teeth and adds jt/(2*tan(alpha_t)) to center distance.",
              "oneOf": [
                { "const": "tooth_thinning", "title": "Tooth Thinning (Fixed Center Distance)" },
                { "const": "center_distance", "title": "Center Distance Increase (Nominal Teeth)" }
              ],
              "default": "tooth_thinning"
            }
          }
        }
      }
    ]
  }
}
